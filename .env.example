# AGRICOMPLY AI Environment Variables

PROJECT_NAME="AGRICOMPLY AI"
VERSION="1.0.0"
API_V1_STR="/api"

# Local Storage (Defaults to SQLite agri_comply.db for local dev)
DATABASE_URL="sqlite:///./agri_comply.db"
UPLOAD_DIR="./data/uploads"

# Optional Zero-Cost Local LLM Support (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
ENABLE_LOCAL_LLM="false"
